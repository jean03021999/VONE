# Configuration LAKOLI d'une école : installation sur UN SEUL POSTE (modèle utilisé par installer.ps1,
# qui remplace les valeurs __ENTRE_TIRETS__).

APP_NAME=LAKOLI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Adresse locale uniquement : LAKOLI n'est accessible que depuis ce PC.
APP_URL=http://127.0.0.1:__PORT__
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Code de vérification à la connexion (OTP) : DÉSACTIVÉ pour cette installation sur un seul poste.
# La connexion se fait avec l'e-mail et le mot de passe ; les tentatives restent limitées.
# Ce réglage n'est accepté que si LAKOLI reste en accès local (APP_URL en 127.0.0.1 et serveur à
# l'écoute sur 127.0.0.1) : sinon, le code de vérification est réactivé automatiquement.
#
# POUR OUVRIR L'ACCÈS EN RÉSEAU (autres ordinateurs de l'école) : repasser OTP_ACTIF=true ET
# configurer l'envoi d'e-mails (MAIL_MAILER=smtp, MAIL_HOST, MAIL_PORT, MAIL_USERNAME,
# MAIL_PASSWORD, MAIL_FROM_ADDRESS) pour que le code parvienne aux utilisateurs.
OTP_ACTIF=false

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=__BASE__
DB_USERNAME=__UTILISATEUR__
DB_PASSWORD=__MOT_DE_PASSE__
DB_PERSISTENT=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
